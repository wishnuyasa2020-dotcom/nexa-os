# Environment Variables — Nexa OS
# Copy file ini ke .env dan isi dengan nilai asli.
# JANGAN commit file .env ke GitHub!

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (MySQL Hostinger) ────────────────────
DB_HOST=your-hostinger-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ── Nexa Admin ────────────────────────────────────
# Key yang sama dengan NEXA_ADMIN_KEY di GAS Script Properties
NEXA_ADMIN_KEY=your-admin-key-here

# ── WhatsApp / Meta (akan diisi nanti) ────────────
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
